### Variables
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Terminal emulator
set $term foot

# Application launcher
set $menu rofi -show drun -theme ~/dotfiles/rofi/launcher/config.rasi

### Wallpaper
output * bg ~/Pictures/wallpaper.jpg fill

### Idle configuration
exec swayidle -w \
    timeout 300 'swaylock -f -c 1E2127' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f'

### Input configuration
input "type:keyboard" {
    xkb_layout us
    xkb_variant altgr-intl
    repeat_delay 250
    repeat_rate 40
}

input "type:touchpad" {
    tap enabled
    tap_button_map lrm
    natural_scroll enabled
    dwt enabled
    dwtp enabled
    scroll_method two_finger
}

### Window borders
default_border pixel 1
default_floating_border normal
hide_edge_borders smart
smart_borders on

## Styles:       border  background text    indicator child_border
client.focused   #282b31 #1e2127    #dadbdf #2e9ef4   #282b31
client.unfocused #000000 #171717    #7b7c7d #292d2e   #000000

### Includes
include ./keybindings.conf
include ./floating-windows.conf

### Waybar
bar {
    swaybar_command waybar
}

### Start default apps
exec /run/current-system/sw/libexec/polkit-gnome-authentication-agent-1
exec swaymsg "workspace 1; exec firefox"

include /etc/sway/config.d/*
